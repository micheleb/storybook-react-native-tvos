{
  "name": "expo-example-tv",
  "version": "10.1.11",
  "private": true,
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf node_modules/.cache .expo",
    "storybook": "EXPO_TV=1 EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start -c",
    "storybook:clean": "yarn clean && yarn storybook",
    "android": "EXPO_TV=1 EXPO_PUBLIC_STORYBOOK_ENABLED=true npx expo run:android",
    "ios": "EXPO_TV=1 EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --ios",
    "prebuild": "EXPO_TV=1 expo prebuild --clean",
    "prebuild:android": "EXPO_TV=1 expo prebuild --clean --platform android",
    "prebuild:ios": "EXPO_TV=1 expo prebuild --clean --platform ios",
    "run:android": "EXPO_TV=1 expo run:android",
    "run:ios": "EXPO_TV=1 expo run:ios",
    "storybook-generate": "sb-rn-get-stories",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "check": "tsc --noEmit",
    "eas-build-post-install": "cd ../.. && yarn build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@storybook/addon-ondevice-controls": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-native": "^10.1.11",
    "@storybook/react-native-ui-lite": "^10.1.11",
    "expo": "^54.0.30",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "npm:react-native-tvos@0.81-stable",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.3",
    "react-native-safe-area-context": "^5",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1",
    "storybook": "^10.1.11"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native-tvos/config-tv": "^0.1.4",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  }
}
